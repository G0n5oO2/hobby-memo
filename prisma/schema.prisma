generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("hobby_search_POSTGRES_PRISMA_URL")
  directUrl = env("hobby_search_POSTGRES_URL_NON_POOLING")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  gender         String?
  age            Int?
  interests      String?
  onboardingStep String   @default("PROFILE") // PROFILE -> QUIZ -> SUGGESTIONS -> DONE
  extendedQuiz   Boolean  @default(false)
  createdAt      DateTime @default(now())

  sessions    Session[]
  userHobbies UserHobby[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Hobby {
  id          String   @id @default(cuid())
  name        String
  category    String
  level       Int // 1: 始めやすい ... 3: じっくり型
  tags        String // カンマ区切りキーワード
  description String

  userHobbies UserHobby[]
}

model UserHobby {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobbyId        String
  hobby          Hobby    @relation(fields: [hobbyId], references: [id])
  characterName  String
  characterLevel Int      @default(1)
  startedAt      DateTime @default(now())
  shareToken     String?  @unique

  diaryEntries DiaryEntry[]

  @@index([userId])
}

model DiaryEntry {
  id          String    @id @default(cuid())
  userHobbyId String
  userHobby   UserHobby @relation(fields: [userHobbyId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())

  @@index([userHobbyId])
}
